{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immersive-reader.local/schemas/settings-v3.json",
  "title": "Immersive Reader Settings v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "libraryRoot"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "libraryRoot": {
      "type": "string",
      "minLength": 1,
      "pattern": "^([A-Za-z]:[\\\\/]|\\\\\\\\)",
      "description": "Absolute Windows path (drive-rooted or UNC), matching the Rust loader's Path::is_absolute requirement"
    }
  }
}
