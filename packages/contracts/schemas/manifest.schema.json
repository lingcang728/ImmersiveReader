{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immersive-reader.local/schemas/manifest-v1.json",
  "title": "Immersive Reader Book Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bookId", "title", "source", "generatedAt", "updatedAt", "chapters"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bookId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source": { "enum": ["zhihu", "manual", "podcast"] },
    "sourceId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$" },
    "updatedAt": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$" },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "title", "voteCount", "wordCount"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Forward-slash relative path; every segment must be non-empty, not . or .., free of \\ NUL : < > | ? *, not a reserved device basename (CON/PRN/AUX/NUL/COM1-9/LPT1-9 case-insensitively, before the first .), and not end in . or space. Mirrors isSafeRelativePath (TS) and is_safe_relative_path (Rust).",
            "pattern": "^(?!/)(?![A-Za-z]:)(?=[\\s\\S]*\\S)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))[^\\\\/:*?<>|\\u0000]*[^\\\\/:*?<>|\\u0000. ](?:/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))[^\\\\/:*?<>|\\u0000]*[^\\\\/:*?<>|\\u0000. ])*$"
          },
          "title": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "voteCount": { "type": "integer", "minimum": 0 },
          "wordCount": { "type": "integer", "minimum": 0, "description": "Non-whitespace Unicode scalar value (code point) count, not UTF-16 code units." },
          "metadataStatus": { "enum": ["complete", "inferred"] }
        }
      }
    }
  }
}
