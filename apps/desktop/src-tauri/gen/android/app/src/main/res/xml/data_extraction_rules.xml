<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ counterpart of backup_rules.xml: keep the Keystore-backed
     ir_secrets SharedPreferences, databases, and private files out of
     both cloud backups and device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ir_secrets.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="Private" />
        <exclude domain="root" path="Private" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ir_secrets.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="Private" />
        <exclude domain="root" path="Private" />
    </device-transfer>
</data-extraction-rules>
