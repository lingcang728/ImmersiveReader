{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "沉浸阅读",
  "version": "1.2.1",
  "identifier": "com.lingcang.immersivereading",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run check && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray-icon.ico",
      "iconAsTemplate": false,
      "tooltip": "沉浸阅读"
    },
    "windows": [
      {
        "title": "沉浸阅读",
        "width": 900,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: tauri:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' http://127.0.0.1:21743 http://127.0.0.1:21744 http://127.0.0.1:21745 http://127.0.0.1:21746 http://127.0.0.1:21747 http://127.0.0.1:21748 http://127.0.0.1:21749 http://127.0.0.1:21750; img-src 'self' asset: tauri: data: blob: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline' asset: tauri:; script-src 'self' asset: tauri:; font-src 'self' asset: tauri: data:; object-src 'none'; base-uri 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1RTk2MEU3RjI0NzlGQjkKUldTNW4wZnk1MkRwRlJEdnBvaVdKbUhCVjVTQzNHMytyRElHVnNmRTgzREUzN1BtQUUyZW5XaU0K",
      "endpoints": [
        "https://github.com/lingcang728/ImmersiveReader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "lingcang728",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installerHooks": "installer-hooks.nsi"
      }
    },
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
