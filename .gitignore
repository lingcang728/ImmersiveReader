# Workspace dependencies and build products
**/node_modules/
**/.svelte-kit/
**/build/
**/dist/
**/target/
**/.pytest_cache/
**/__pycache__/
**/*.py[cod]

# Local runtimes and models
runtime/
# Transient swap dirs created by scripts/prepare-runtime.ps1
runtime.__staging__/
runtime.__previous__/
# Local dev-install output (see docs/release/*/release-manifest.json)
.dev-install/
**/.venv/
**/venv/
**/models/
**/.browser-profile/
**/.obscura-profile/
**/.browser-cache/

# User content and runtime state
/Library/
**/input/*
**/output/*
**/work/
!**/input/.gitkeep
!**/output/.gitkeep
**/*.db
**/*.db-*
**/*.sqlite*
**/*.log
**/config.json
**/.env*
!**/.env.example

# Credentials and package artifacts
**/*.key
**/*.pem
**/*.p12
**/*.pfx
# DPAPI-encrypted updater key backups (see apps/desktop/scripts/package-and-install.ps1)
**/*.dpapi
# Local signing/test certificates must never be committed
**/keystore.properties
**/*.keystore
**/*.jks
**/*.cer
**/*.crt
**/*.msi
**/*.exe
# Deployed shell icon next to the production EXE (copied by ship:local)
/immersive-reader.ico
**/*.zip

# QA artifacts
artifacts/
playwright-report/
test-results/
*.tmp
*.bak

# Operating system metadata
.DS_Store
Thumbs.db
desktop.ini
